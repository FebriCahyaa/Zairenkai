# Never commit owner keys or issued tokens
*.pem
*.key
*.zkl
*.zksub
*.zkcrl
keys/
.zkfc/

# Build outputs
build/
*.o
*.ko

local.properties
.gradle/
app/build/
build/
*.apk
*.keystore
/out/
kernel/out/

keystore.properties
*.jks
*.p12
*.gpg
secring.*
.kotlin/

/rust/target/
__pycache__/

# Generated Android boot-patch helper executables
/app/src/main/jniLibs/
/native/bootpatch/target/
/app/src/main/assets/zkfc/

# Generated, release-specific root module embedded into APKs
/app/src/main/assets/embedded/

# Owner-authorized grants generated locally for a specific kernel build
/kernel/license/zkfc_license.inc
/kernel/license/zkfc_bundle.inc
/kernel/license/zkfc_crl.inc

# Public update-metadata verification key is intentionally tracked.
!app/src/main/assets/security/update-metadata-public-key.pem
