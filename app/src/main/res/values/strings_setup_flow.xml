    <string name="setup_perm_title">App permissions</string>
    <string name="setup_perm_body">Only permissions Zairenkai\'s features really use. You can change them any time in Android settings.</string>
    <string name="setup_perm_note">Every permission is optional. Without one, the feature that needs it asks again when you open it. Root is granted by your root manager, not here.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">The FPS recorder and the history recorder run as background services, and Android requires a notification while they are active.</string>
    <string name="perm_usage_title">Usage access</string>
    <string name="perm_usage_body">To know which app is open: used by per-app profiles, Auto mode and usage history.</string>
    <string name="perm_battery_title">Battery optimisation</string>
    <string name="perm_battery_body">Exclude Zairenkai so Android does not stop the recorders in the background. Choose Zairenkai, then Don\'t optimise.</string>
