    <!-- 1. Welcome -->
    <!-- Typed greeting on the first page: "Halo" is typed and erased, then the app name, then this tagline in the brand gradient. -->
    <string name="setup_greeting_hello">Halo</string>
    <string name="setup_greeting_tagline">Performa, dengan caramu.</string>
    <string name="setup_welcome_title">Kenali Zairenkai</string>
    <string name="setup_welcome_body">Kendali sistem Android, dalam satu pengalaman yang lebih intuitif.</string>
    <string name="setup_feature_monitor_title">Monitor langsung</string>
    <string name="setup_feature_monitor_body">FPS game yang kamu pilih, beban CPU per core, GPU, baterai, dan suhu.</string>
    <string name="setup_feature_verified_title">Profil &amp; tweak terverifikasi</string>
    <string name="setup_feature_verified_body">Setiap perubahan diterapkan zperfd, dibaca balik dari kernel, dan dibatalkan otomatis bila gagal.</string>
    <string name="setup_feature_safety_title">Berlapis pengaman</string>
    <string name="setup_feature_safety_body">Guard termal kernel, Sentinel, dan SAFE MODE setelah boot gagal. Fitur performa dibuka dengan token API.</string>
    <string name="setup_welcome_note">Penyiapan hanya memeriksa sistem. Tidak ada pengaturan yang diubah sampai kamu sendiri memilih profil.</string>

