    <!-- Frame-drop events. %1$s = time in the session (m:ss). -->
    <string name="fps_drop_hitch">%1$s · Brief hitch: one frame was held for %2$d ms. This usually happens while the game loads assets, compiles shaders or frees memory.</string>
    <string name="fps_drop_thermal" tools:ignore="PluralsCandidate">%1$s · FPS fell from %2$d to %3$d for %4$d s while battery temperature had risen %5$s °C since the session started. The device likely lowered its clocks because of heat (thermal throttling).</string>
    <string name="fps_drop_sustained" tools:ignore="PluralsCandidate">%1$s · FPS fell from %2$d to %3$d for %4$d s (longest frame %5$d ms). A long, heavy scene: the CPU or GPU was working at its limit.</string>
    <string name="fps_drop_brief" tools:ignore="PluralsCandidate">%1$s · Short dip from %2$d to %3$d FPS for %4$d s (longest frame %5$d ms), then recovered.</string>

    <!-- Session insights -->
    <string name="fps_insight_no_data">Not enough frames to analyze yet.</string>
    <string name="fps_insight_stable" tools:ignore="PluralsCandidate">Very stable: %1$d%% of the time within ±10%% of the %2$d FPS median.</string>
    <string name="fps_insight_mostly_stable" tools:ignore="PluralsCandidate">Fairly stable: %1$d%% of the time within ±10%% of the %2$d FPS median, with a few dips.</string>
    <string name="fps_insight_unstable" tools:ignore="PluralsCandidate">Unstable: only %1$d%% of the time near the %2$d FPS median; FPS swings ±%3$d from second to second.</string>
    <string name="fps_insight_capped" tools:ignore="PluralsCandidate">FPS appears capped at %1$d while the display runs at %2$d Hz. If the game offers a higher frame rate option, turn it on to use the full refresh rate.</string>
    <string name="fps_insight_low_lows" tools:ignore="PluralsCandidate">1%% low is only %1$d FPS versus a %2$d average: occasional hitches you can feel even though the average is high.</string>
    <string name="fps_insight_pacing">Uneven frame pacing: frame intervals vary by ±%1$s ms around a %2$s ms average, which feels like micro-stutter.</string>
    <string name="fps_insight_thermal_decline">FPS dropped %1$d%% in the last third of the session while battery temperature rose %2$s °C: a sign of thermal throttling.</string>
    <string name="fps_insight_decline">FPS dropped %1$d%% in the last third of the session compared with the start, with no significant temperature rise: likely heavier scenes.</string>
    <plurals name="fps_insight_stutters">
        <item quantity="one">%1$d visible hitch over 100 ms (%2$d ms).</item>
        <item quantity="other">%1$d visible hitches over 100 ms (longest %2$d ms).</item>
    </plurals>
    <string name="fps_insight_jank_rate" tools:ignore="PluralsCandidate">About %1$d jank per minute: frames that took more than twice as long as their own recent pace.</string>
    <string name="fps_insight_power">Average power %1$s W, peak battery temperature %2$s °C during the session.</string>
    <string name="fps_insight_all_good">No significant performance issues in this session.</string>

