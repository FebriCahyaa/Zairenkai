    <!-- 1. Welcome -->
    <string name="setup_welcome_title">Welcome to Zairenkai</string>
    <string name="setup_welcome_body">Performance control for rooted devices, run by the zperfd engine on top of the ZKFC kernel framework.</string>
    <string name="setup_feature_monitor_title">Live monitor</string>
    <string name="setup_feature_monitor_body">FPS for the games you choose, per-core CPU load, GPU, battery and temperatures.</string>
    <string name="setup_feature_verified_title">Verified profiles &amp; tweaks</string>
    <string name="setup_feature_verified_body">Every change is applied by zperfd, read back from the kernel, and rolled back automatically if it fails.</string>
    <string name="setup_feature_safety_title">Layered safeguards</string>
    <string name="setup_feature_safety_body">Kernel thermal guard, Sentinel, and SAFE MODE after a failed boot. Performance features are unlocked with an API token.</string>
    <string name="setup_welcome_note">Setup only checks the system. No settings are changed until you choose a profile yourself.</string>

    <!-- 2. System check -->
    <string name="setup_check_title">System check</string>
    <string name="setup_check_body">Zairenkai works in layers: root access, the ZKFC kernel framework, the zperfd engine, then the API token.</string>
    <string name="setup_check_root">Root access</string>
    <string name="setup_check_zkfc">ZKFC kernel framework</string>
    <string name="setup_check_engine">zperfd engine</string>
    <string name="setup_check_token">API token</string>
    <string name="setup_needs_root">Requires root access.</string>
    <string name="setup_root_checking">Requesting root permission…</string>
    <string name="setup_root_ok">Root permission granted.</string>
    <string name="setup_root_missing">Root permission denied or no root manager found.</string>
    <string name="setup_root_fix">Allow Zairenkai in Magisk, KernelSU or APatch, then check again.</string>
    <string name="setup_root_no_su">No root manager (su) was found on this device.</string>
    <string name="setup_root_no_su_fix">Install Magisk, KernelSU or APatch, then check again.</string>
    <string name="setup_root_timeout">The root permission request hasn\'t been answered yet.</string>
    <string name="setup_root_timeout_fix">Answer the permission dialog in your root manager, then tap Check again.</string>
    <string name="setup_zkfc_checking">Reading /dev/zkfc…</string>
    <string name="setup_zkfc_missing">Not loaded.</string>
    <string name="setup_zkfc_fix">Install the Zairenkai module with the ZKFC kernel module that matches this kernel, then reboot.</string>
    <string name="setup_zkfc_module_missing">The Zairenkai module isn\'t installed (zkfctl not found).</string>
    <string name="setup_zkfc_reboot_pending">The Zairenkai module was just installed and isn\'t active yet.</string>
    <string name="setup_zkfc_reboot_pending_fix">Reboot the device to activate the module, then check again.</string>
    <string name="setup_zkfc_module_disabled">The Zairenkai module is disabled in your root manager.</string>
    <string name="setup_zkfc_module_disabled_fix">Enable the module in Magisk/KernelSU/APatch, reboot, then check again.</string>
    <string name="setup_zkfc_module_removing">The Zairenkai module is marked for removal on reboot.</string>
    <string name="setup_zkfc_module_removing_fix">Cancel the removal in your root manager if you still want to use it.</string>
    <!-- %1$s: device ABI, e.g. arm64-v8a -->
    <string name="setup_zkfc_tool_missing">The module is installed, but zkfctl is missing. The package may not include a binary for the %1$s ABI.</string>
    <string name="setup_zkfc_tool_not_executable">zkfctl exists, but it can\'t be run (file permissions).</string>
    <string name="setup_reinstall_module_fix">Reinstall the Zairenkai module that matches this device, then reboot.</string>
    <!-- %1$s: kernel release -->
    <string name="setup_zkfc_ko_failed">zkfc.ko failed to load on kernel %1$s (/dev/zkfc is missing).</string>
    <string name="setup_zkfc_ko_failed_fix">The kernel module doesn\'t match this kernel\'s KMI. Use a package built for this kernel.</string>
    <!-- %1$s: kernel release -->
    <string name="setup_zkfc_not_in_kernel">Kernel %1$s doesn\'t provide the ZKFC framework (/dev/zkfc is missing), and the package doesn\'t include a zkfc.ko for it.</string>
    <string name="setup_zkfc_timeout">zkfctl didn\'t respond within the time limit.</string>
    <string name="setup_zkfc_timeout_fix">Check again. If it keeps happening, reboot the device.</string>
    <string name="setup_zkfc_malformed">zkfctl responded in an unrecognized format (version mismatch?).</string>
    <string name="setup_zkfc_outdated">%1$s (outdated)</string>
    <string name="setup_zkfc_outdated_fix">Update the ZKFC kernel module; new features are disabled on the old API.</string>
    <string name="setup_engine_checking">Contacting zperfd…</string>
    <string name="setup_engine_missing">Not installed in /data/adb/zperf yet.</string>
    <string name="setup_engine_missing_fix">Install the Zairenkai module; zperfd is the only path that applies profiles and tweaks.</string>
    <string name="setup_engine_not_executable">zperfd is in /data/adb/zperf, but it can\'t be run.</string>
    <string name="setup_engine_silent">Installed, but not responding.</string>
    <string name="setup_engine_not_running">Installed, but its service isn\'t running.</string>
    <string name="setup_engine_silent_fix">Reboot so the module service starts zperfd, then check again.</string>
    <string name="setup_engine_safe_mode">Running · SAFE MODE (stock baseline held)</string>
    <string name="setup_engine_saved">Running · saved profile: %1$s</string>
    <string name="setup_engine_default">Running · engine default: %1$s</string>
    <string name="setup_token_checking">Reading license status…</string>
    <string name="setup_token_needs_zkfc">Requires the ZKFC kernel framework.</string>
    <string name="setup_token_stored_waiting">Token saved, but it can only be verified once the ZKFC framework is active.</string>
    <string name="setup_token_ok">Token valid; performance features unlocked.</string>
    <string name="setup_token_missing">Not installed: performance profiles and tweaks stay locked.</string>
    <string name="setup_token_missing_fix">Install a token in the System tab. The monitor still works without a token.</string>
    <string name="setup_token_bad">Token %1$s.</string>
    <string name="setup_token_bad_fix">Install a token issued for this device and kernel in the System tab.</string>
    <string name="setup_check_all_ok">All components are ready.</string>
    <string name="setup_check_ready_with_notes">Ready to use, with the notes above.</string>
    <string name="setup_check_not_ready">Some components aren\'t ready yet. You can still continue; features that need them will stay locked until the issue is resolved.</string>
    <string name="setup_recheck">Check again</string>
    <string name="setup_state_checking">checking</string>
    <string name="setup_state_ok">ready</string>
    <string name="setup_state_warn">needs attention</string>
    <string name="setup_state_missing">not ready</string>
    <string name="setup_check_a11y">%1$s: %2$s. %3$s</string>
    <string name="setup_check_summary_row">%1$s: %2$s</string>

    <!-- License states, as "Token <state>." -->
    <string name="license_state_valid">valid</string>
    <string name="license_state_missing">not installed</string>
    <string name="license_state_expired">expired</string>
    <string name="license_state_bad_signature">has an invalid signature</string>
    <string name="license_state_wrong_binding">bound to another device/kernel</string>
