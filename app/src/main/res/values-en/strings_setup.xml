    <!-- 3. First profile -->
    <string name="setup_profile_title">Choose a first profile</string>
    <string name="setup_profile_body">Optional. Profiles are zperfd modes; their values are aligned to the device frequency table and still limited by the thermal envelope.</string>
    <string name="setup_profile_blocked">Profiles can be applied once %1$s is ready. You can choose one later in the Profiles tab.</string>

