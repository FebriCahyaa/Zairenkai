    <!-- 3. First profile -->
    <string name="setup_profile_title">Elige un perfil inicial</string>
    <string name="setup_profile_body">Opcional. Los perfiles son modos de zperfd; sus valores se ajustan a la tabla de frecuencias del dispositivo y siguen limitados por la envolvente térmica.</string>
    <string name="setup_profile_blocked">Podrás aplicar perfiles cuando %1$s esté listo. Puedes elegirlo más tarde en la pestaña Perfiles.</string>

