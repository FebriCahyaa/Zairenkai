    <!-- 1. Welcome -->
    <string name="setup_welcome_title">Te damos la bienvenida a Zairenkai</string>
    <string name="setup_welcome_body">Control de rendimiento para dispositivos con root, gestionado por el motor zperfd sobre el framework de kernel ZKFC.</string>
    <string name="setup_feature_monitor_title">Monitor en vivo</string>
    <string name="setup_feature_monitor_body">FPS de la UI, carga de CPU por núcleo, GPU y temperatura de las zonas térmicas.</string>
    <string name="setup_feature_verified_title">Perfiles y ajustes verificados</string>
    <string name="setup_feature_verified_body">zperfd aplica cada cambio, que se relee desde el kernel y se revierte automáticamente si falla.</string>
    <string name="setup_feature_safety_title">Varias capas de seguridad</string>
    <string name="setup_feature_safety_body">Protección térmica del kernel, Sentinel y SAFE MODE tras un arranque fallido. Las funciones de rendimiento se desbloquean con un token de API.</string>
    <string name="setup_welcome_note">La configuración solo comprueba el sistema. No se cambia ningún ajuste hasta que elijas un perfil tú mismo.</string>

    <!-- 2. System check -->
    <string name="setup_check_title">Comprobación del sistema</string>
    <string name="setup_check_body">Zairenkai funciona por capas: acceso root, framework de kernel ZKFC, motor zperfd y, por último, el token de API.</string>
    <string name="setup_check_root">Acceso root</string>
    <string name="setup_check_zkfc">Framework de kernel ZKFC</string>
    <string name="setup_check_engine">Motor zperfd</string>
    <string name="setup_check_token">Token de API</string>
    <string name="setup_needs_root">Requiere acceso root.</string>
    <string name="setup_root_checking">Solicitando permiso de root…</string>
    <string name="setup_root_ok">Permiso de root concedido.</string>
    <string name="setup_root_missing">Permiso de root denegado o no se encontró un gestor de root.</string>
    <string name="setup_root_fix">Permite Zairenkai en Magisk, KernelSU o APatch y vuelve a comprobar.</string>
    <string name="setup_zkfc_checking">Leyendo /dev/zkfc…</string>
    <string name="setup_zkfc_missing">No cargado.</string>
    <string name="setup_zkfc_missing_detail">No cargado: %1$s</string>
