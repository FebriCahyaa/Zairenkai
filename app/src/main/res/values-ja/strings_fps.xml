    <!-- Frame-drop events. %1$s = time in the session (m:ss). -->
    <string name="fps_drop_hitch">%1$s · 一瞬のカクつき: 1 フレームが %2$d ms 止まりました。よくある原因はアセットの読み込み、シェーダーのコンパイル、メモリの解放ですが、フレームデータだけでは原因を断定できません。</string>
    <string name="fps_drop_thermal" tools:ignore="PluralsCandidate">%1$s · FPS が %4$d 秒間 %2$d から %3$d に低下し、同時にバッテリー温度がセッション開始時から %5$s °C 上昇しました。発熱が影響している可能性があります（サーマルスロットリングなど）が、このデータが示しているのは両者が同時に起きたことだけです。</string>
    <string name="fps_drop_sustained" tools:ignore="PluralsCandidate">%1$s · FPS が %4$d 秒間 %2$d から %3$d に低下しました（最長フレーム %5$d ms）。CPU または GPU に負荷をかける重いシーンだった可能性があります。</string>
    <string name="fps_drop_brief" tools:ignore="PluralsCandidate">%1$s · %4$d 秒間 %2$d から %3$d FPS に一時的に低下し（最長フレーム %5$d ms）、その後回復しました。</string>

    <!-- Session insights -->
    <string name="fps_insight_no_data">分析に必要なフレームがまだ足りません。</string>
    <string name="fps_insight_stable" tools:ignore="PluralsCandidate">非常に安定: 時間の %1$d%% が中央値 %2$d FPS の ±10%% 以内でした。</string>
    <string name="fps_insight_mostly_stable" tools:ignore="PluralsCandidate">おおむね安定: 時間の %1$d%% が中央値 %2$d FPS の ±10%% 以内で、何度か低下がありました。</string>
    <string name="fps_insight_unstable" tools:ignore="PluralsCandidate">不安定: 中央値 %2$d FPS 付近だったのは時間の %1$d%% のみで、FPS は 1 秒ごとに ±%3$d 変動しました。</string>
    <string name="fps_insight_capped" tools:ignore="PluralsCandidate">画面は %2$d Hz で動作していますが、FPS は %1$d に制限されているようです。ゲームにより高いフレームレートの設定があれば、有効にしてリフレッシュレートを最大限に活用しましょう。</string>
    <string name="fps_insight_low_lows" tools:ignore="PluralsCandidate">1%% low は平均 %2$d に対して %1$d FPS しかありません。平均が高くても、ときどき体感できるカクつきがあります。</string>
    <string name="fps_insight_pacing">フレームペーシングが不均一です: フレーム間隔が平均 %2$s ms に対して ±%1$s ms ばらつき、マイクロスタッターとして感じられます。</string>
    <string name="fps_insight_thermal_decline">セッションの最後の 3 分の 1 で FPS が %1$d%% 低下し、同時にバッテリー温度が %2$s °C 上昇しました。発熱が影響している可能性があります（サーマルスロットリング）が、このデータから正確な原因を特定することはできません。</string>
    <string name="fps_insight_decline">セッションの最後の 3 分の 1 で FPS が序盤より %1$d%% 低下しましたが、目立った温度上昇はありません: より重いシーンによる可能性があります。</string>
    <plurals name="fps_insight_stutters">
        <item quantity="other">目で見てわかる 100 ms 超のカクつきが %1$d 回ありました（最長 %2$d ms）。</item>
    </plurals>
    <string name="fps_insight_jank_rate" tools:ignore="PluralsCandidate">1 分あたり約 %1$d 回の Jank: 自身のフレーム間隔の 2 倍を超えて遅れたフレームです。</string>
    <string name="fps_insight_power">セッション中の平均電力 %1$s W、バッテリー最高温度 %2$s °C。</string>
    <string name="fps_insight_all_good">このセッションでは目立ったパフォーマンスの問題はありませんでした。</string>

