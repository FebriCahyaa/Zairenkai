    <!-- 1. Welcome -->
    <string name="setup_welcome_title">欢迎使用 Zairenkai</string>
    <string name="setup_welcome_body">面向 root 设备的性能控制，由运行在 ZKFC 内核框架之上的 zperfd 引擎驱动。</string>
    <string name="setup_feature_monitor_title">实时监控</string>
    <string name="setup_feature_monitor_body">UI FPS、每核心 CPU 负载、GPU 以及温控区温度。</string>
    <string name="setup_feature_verified_title">经验证的配置与调校</string>
    <string name="setup_feature_verified_body">每项更改都由 zperfd 应用，并从内核回读；失败时自动回滚。</string>
    <string name="setup_feature_safety_title">多层安全防护</string>
    <string name="setup_feature_safety_body">内核温控保护、Sentinel，以及启动失败后的 SAFE MODE。性能功能需使用 API 令牌解锁。</string>
    <string name="setup_welcome_note">设置向导只检查系统。在你亲自选择配置之前，不会更改任何设置。</string>

