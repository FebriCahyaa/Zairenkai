    <!-- Frame-drop events. %1$s = time in the session (m:ss). -->
    <string name="fps_drop_hitch">%1$s · 瞬间卡顿：一帧卡住了 %2$d ms。通常发生在游戏加载资源、编译着色器或清理内存时。</string>
    <string name="fps_drop_thermal" tools:ignore="PluralsCandidate">%1$s · FPS 从 %2$d 降至 %3$d，持续 %4$d 秒，此时电池温度较会话开始时升高了 %5$s °C。设备可能因发热而降低频率（温控降频）。</string>
    <string name="fps_drop_sustained" tools:ignore="PluralsCandidate">%1$s · FPS 从 %2$d 降至 %3$d，持续 %4$d 秒（最长帧 %5$d ms）。长时间的高负载场景：CPU 或 GPU 已达到极限。</string>
    <string name="fps_drop_brief" tools:ignore="PluralsCandidate">%1$s · FPS 从 %2$d 短暂降至 %3$d，持续 %4$d 秒（最长帧 %5$d ms），随后恢复。</string>

    <!-- Session insights -->
    <string name="fps_insight_no_data">帧数不足，暂无法分析。</string>
    <string name="fps_insight_stable" tools:ignore="PluralsCandidate">非常稳定：%1$d%% 的时间处于中位数 %2$d FPS 的 ±10%% 以内。</string>
    <string name="fps_insight_mostly_stable" tools:ignore="PluralsCandidate">较为稳定：%1$d%% 的时间处于中位数 %2$d FPS 的 ±10%% 以内，偶有下降。</string>
    <string name="fps_insight_unstable" tools:ignore="PluralsCandidate">不稳定：仅 %1$d%% 的时间接近中位数 %2$d FPS；FPS 每秒波动 ±%3$d。</string>
    <string name="fps_insight_capped" tools:ignore="PluralsCandidate">FPS 似乎被锁定在 %1$d，而屏幕刷新率为 %2$d Hz。如果游戏提供更高帧率选项，开启后即可用满刷新率。</string>
    <string name="fps_insight_low_lows" tools:ignore="PluralsCandidate">1%% low 仅 %1$d FPS，而平均为 %2$d：即使平均帧率很高，仍能感觉到偶发卡顿。</string>
    <string name="fps_insight_pacing">帧间隔不均：帧间隔在平均 %2$s ms 上下波动 ±%1$s ms，表现为微卡顿。</string>
    <string name="fps_insight_thermal_decline">会话最后三分之一时段 FPS 下降了 %1$d%%，同时电池温度升高 %2$s °C：表明出现温控降频。</string>
    <string name="fps_insight_decline">会话最后三分之一时段 FPS 比开头下降了 %1$d%%，且温度无明显上升：可能是场景负载更重。</string>
    <plurals name="fps_insight_stutters">
        <item quantity="other">出现 %1$d 次超过 100 ms 的肉眼可见卡顿（最长 %2$d ms）。</item>
    </plurals>
    <string name="fps_insight_jank_rate" tools:ignore="PluralsCandidate">每分钟约 %1$d 次 Jank：即耗时超过自身正常节奏两倍以上的帧。</string>
    <string name="fps_insight_power">会话期间平均功率 %1$s W，电池最高温度 %2$s °C。</string>
    <string name="fps_insight_all_good">本次会话未发现明显的性能问题。</string>

